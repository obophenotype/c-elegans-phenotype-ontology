AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/CHEBI_35705> "CHEBI:35705")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/CHEBI_35705> <http://purl.obolibrary.org/obo/chebi/3_STAR>)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CHEBI_35705> "immunosuppressive agent")
SubClassOf(<http://purl.obolibrary.org/obo/CHEBI_35705> <http://purl.obolibrary.org/obo/CHEBI_50846>)

