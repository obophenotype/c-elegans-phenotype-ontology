# Class: <http://purl.obolibrary.org/obo/CHEBI_64203> (methiothepin)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CHEBI_64203> "A dibenzothiepine that is 10,11-dihydrodibenzo[<em>b,f</em>]thiepine bearing additional methylthio and 4-methylpiperazin-1-yl substituents at positions 8 and 10 respectively. Potent 5-HT<small><sub>2</sub></small> antagonist, also active as 5-HT<small><sub>1</sub></small> antagonist. Differentiates 5-HT<small><sub>1D</sub></small> sub-types. Also displays affinity for rodent 5-HT<small><sub>5B</sub></small>, 5-HT<small><sub>5A</sub></small>, 5-HT<small><sub>7</sub></small> and 5-HT<small><sub>6</sub></small> receptors (pK1 values are 6.6, 7.0, 8.4 and 8.7 respectively).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/CHEBI_64203> "chebi_ontology")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chemidplus") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_64203> "(+-)-1-(10,11-Dihydro-8-(methylthio)dibenzo(b,f)thiepin-10-yl)-4-methylpiperazine")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chemidplus") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_64203> "(+-)-10-(4-Methylpiperazinyl)-8-(methylthio)-10,11-dihydrodibenzo(b,f)thiepin")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chemidplus") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_64203> "(+-)-8-Methylthio-10-(4-methylpiperazino)-10,11-dihydrodibenzo(b,f)thiepin")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chemidplus") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_64203> "1-(10,11-Dihydro-8-(methylthio)dibenzo(b,f)thiepin-10-yl)-4-methylpiperazine")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "chebi") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/CHEBI_64203> "1-methyl-4-[8-(methylthio)-10,11-dihydrodibenzo[b,f]thiepin-10-yl]piperazine")
