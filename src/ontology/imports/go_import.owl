AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0045143> "GO:0045143")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0045143> "homologous chromosome segregation")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0045143> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0098813> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0007127>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0045143> <http://purl.obolibrary.org/obo/GO_0045132>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0045143> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0007127>))

