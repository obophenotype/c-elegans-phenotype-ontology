# Class: <http://purl.obolibrary.org/obo/GO_0008021> (synaptic vesicle)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10099709") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12563290") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0008021> "A secretory organelle, typically 50 nm in diameter, of presynaptic nerve terminals; accumulates in high concentrations of neurotransmitters and secretes these into the synaptic cleft by fusion with the 'active zone' of the presynaptic plasma membrane.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0008021> "NIF_Subcellular:sao1071221672")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0008021> "Wikipedia:Synaptic_vesicle")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NIF_Subcellular:sao403156667") <http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0008021> "docked vesicle")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0008021> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0008021> "GO:0008021")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0008021> <http://purl.obolibrary.org/obo/go#goslim_synapse>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0008021> "This term should not be confused with GO:0097547 'synaptic vesicle protein transport vesicle'. STVs and synaptic vesicles differ both functionally and morphologically. Functionally, STVs are transport vesicles that deliver synaptic vesicle proteins to synapses, while synaptic vesicles are responsible for transmitter release at synapses. Morphologically, synaptic vesicles are very homogeneous, while STVs are very heterogeneous in size and shape. STVs might be a precursor for synaptic vesicles.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0008021> "synaptic vesicle")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0008021> <http://purl.obolibrary.org/obo/GO_0070382>)
