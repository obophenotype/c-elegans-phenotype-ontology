# Class: <http://purl.obolibrary.org/obo/GO_0036465> (synaptic vesicle recycling)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:PARL") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:pad") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15217342") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22026965") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23245563") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0036465> "The trafficking of synaptic vesicles from the pre-synaptic membrane so the vesicle can dock and prime for another round of exocytosis and neurotransmitter release. Recycling occurs after synaptic vesicle exocytosis, and is necessary to replenish presynaptic vesicle pools, sustain transmitter release and preserve the structural integrity of the presynaptic membrane. Recycling can occur following transient fusion with the presynaptic membrane (kiss and run), or via endocytosis of presynaptic membrane.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#created_by> <http://purl.obolibrary.org/obo/GO_0036465> "bf")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#creation_date> <http://purl.obolibrary.org/obo/GO_0036465> "2014-06-26T11:03:08Z")
