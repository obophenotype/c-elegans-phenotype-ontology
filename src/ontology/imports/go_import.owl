# Class: <http://purl.obolibrary.org/obo/GO_0006898> (receptor-mediated endocytosis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0716731363") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0006898> "An endocytosis process in which cell surface receptors ensure specificity of transport. A specific receptor on the cell surface binds tightly to the extracellular macromolecule (the ligand) that it recognizes; the plasma-membrane region containing the receptor-ligand complex then undergoes endocytosis, forming a transport vesicle containing the receptor-ligand complex and excluding most other plasma-membrane proteins. Receptor-mediated endocytosis generally occurs via clathrin-coated pits and vesicles.")
AnnotationAssertion(Annotation(rdfs:label "Binding and Uptake of Ligands by Scavenger Receptors") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006898> "Reactome:R-HSA-2173782")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0006898> "Wikipedia:Receptor-mediated_endocytosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0006898> "receptor mediated endocytosis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0006898> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0006898> "GO:0006898")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0006898> "receptor-mediated endocytosis")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0006898> <http://purl.obolibrary.org/obo/GO_0006897>)

