# Class: <http://purl.obolibrary.org/obo/GO_0000374> (Group III intron splicing)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11377794") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000374> "The splicing of Group III introns. This occurs by a ribozymic mechanism where the intron sequence forms a distinct 3D structure, characteristic of Group III introns, that is involved in catalyzing the splicing reactions, though protein factors are also required in vivo. Splicing occurs by a series of two transesterification reactions begun by a bulged adenosine residue within the intron sequence as the initiating nucleophile. The intron is excised as a lariat. Though very similar in structure and mechanism to Group II introns, Group III introns are smaller and more streamlined and the splice site consensus sequences are not as well conserved.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0000374> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000374> "mRNA splicing")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0000374> "GO:0000374")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0000374> "Note that Group III introns are known to be found in mRNA of plastids of euglenoid protists.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000374> "Group III intron splicing")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000374> <http://purl.obolibrary.org/obo/GO_0000377>)

# Class: <http://purl.obolibrary.org/obo/GO_0000375> (RNA splicing, via transesterification reactions)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000375> "Splicing of RNA via a series of two transesterification reactions.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0000375> "GO:0000385")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0000375> "GO:0031202")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0000375> "biological_process")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000375> "RNA splicing factor activity, transesterification mechanism")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mah") <http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000375> "pre-mRNA splicing factor activity")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000375> "spliceosomal catalysis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0000375> "GO:0000375")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0000375> <http://purl.obolibrary.org/obo/go#goslim_pir>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0000375> "Note that nuclear mRNA, Group I, Group II, and Group III introns are all spliced by a series of two transesterification reactions that occur within the RNA itself, or between two RNAs in trans splicing. Some of these require one or more proteins to stabilize the catalytic conformation, while others are autocatalytic. Note that tRNA introns are spliced by a different catalytic mechanism.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000375> "RNA splicing, via transesterification reactions")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000375> <http://purl.obolibrary.org/obo/GO_0008380>)

# Class: <http://purl.obolibrary.org/obo/GO_0000377> (RNA splicing, via transesterification reactions with bulged adenosine as nucleophile)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11377794") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000377> "Splicing of RNA via a series of two transesterification reactions with a bulged adenosine residue from the intron branch point as the initiating nucleophile. When the initial RNA for the splicing reaction is a single molecule (cis splicing), the excised intron is released in a lariat structure.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0000377> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000377> "lariat RNA biosynthesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000377> "lariat RNA formation")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0000377> "GO:0000377")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000377> "RNA splicing, via transesterification reactions with bulged adenosine as nucleophile")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000377> <http://purl.obolibrary.org/obo/GO_0000375>)

# Class: <http://purl.obolibrary.org/obo/GO_0000398> (mRNA splicing, via spliceosome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0198506732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0879695897") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000398> "The joining together of exons from one or more primary transcripts of messenger RNA (mRNA) and the excision of intron sequences, via a spliceosomal mechanism, so that mRNA consisting only of the joined exons is produced.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0000398> "GO:0006374")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasAlternativeId> <http://purl.obolibrary.org/obo/GO_0000398> "GO:0006375")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "mRNA splicing")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasBroadSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "pre-mRNA splicing")
AnnotationAssertion(Annotation(rdfs:label "mRNA Splicing - Major Pathway") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0000398> "Reactome:R-HSA-72163")
AnnotationAssertion(Annotation(rdfs:label "mRNA Splicing - Minor Pathway") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0000398> "Reactome:R-HSA-72165")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:vw") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "nuclear mRNA splicing, via spliceosome")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "nuclear mRNA splicing via U12-type spliceosome")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasNarrowSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "nuclear mRNA splicing via U2-type spliceosome")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0000398> "biological_process")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "splicing AT-AC intron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/GO_0000398> "splicing GT-AG intron")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0000398> "GO:0000398")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0000398> "Note that although the many U12-type introns have the sequence AT-AC at the intron termini, some introns with these terminal sequences are spliced by the U2-type spliceosome. The distinguishing characteristics are sequences near the 5' splice site and the branch point sequences of the intron. Note that although the majority of U2-type introns have the sequence GU-AG at the intron termini, some introns with these terminal sequences are spliced by the U12-type spliceosome. The distinguishing characteristics are sequences near the 5' splice site and the branch point sequences of the intron.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000398> "mRNA splicing, via spliceosome")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000398> <http://purl.obolibrary.org/obo/GO_0000377>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000398> <http://purl.obolibrary.org/obo/GO_0006397>)

# Class: <http://purl.obolibrary.org/obo/GO_0000422> (autophagy of mitochondrion)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:autophagy") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15798367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19289147") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23065344") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0000422> "The autophagic process in which mitochondria are delivered to a type of vacuole and degraded in response to changing cellular conditions.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000233> <http://purl.obolibrary.org/obo/GO_0000422> "https://github.com/geneontology/go-ontology/issues/25541"^^xsd:anyURI)
