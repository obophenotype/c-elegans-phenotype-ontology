# Class: <http://purl.obolibrary.org/obo/GO_0032153> (cell division site)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bf") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:imk") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:krc") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:ns") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12101122") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15380095") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16983191") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18165305") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0032153> "The eventual plane of cell division (also known as cell cleavage or cytokinesis) in a dividing cell. In Eukaryotes, the cleavage apparatus, composed of septin structures and the actomyosin contractile ring, forms along this plane, and the mitotic, or meiotic, spindle is aligned perpendicular to the division plane. In bacteria, the cell division site is generally located at mid-cell and is the site at which the cytoskeletal structure, the Z-ring, assembles.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0032153> "cell division plane")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0032153> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0032153> "GO:0032153")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#inSubset> <http://purl.obolibrary.org/obo/GO_0032153> <http://purl.obolibrary.org/obo/go#goslim_pir>)
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0032153> "Note that this term refers to the future site of division in a cell that has not yet divided.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0032153> "cell division site")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0032153> <http://purl.obolibrary.org/obo/GO_0110165>)

# Class: <http://purl.obolibrary.org/obo/GO_0032154> (cleavage furrow)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:vw") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0805319409") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0032154> "The cleavage furrow is a plasma membrane invagination at the cell division site. The cleavage furrow begins as a shallow groove and eventually deepens to divide the cytoplasm.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0032154> "Wikipedia:Cleavage_furrow")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/GO_0032154> "cellular_component")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0032154> "GO:0032154")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0032154> "While the term 'cleavage furrow' was initially associated with animal cells, such a structure occurs in many other types of cells, including unicellular protists.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0032154> "cleavage furrow")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0032154> <http://purl.obolibrary.org/obo/GO_0098590>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0032154> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0032153>))

