AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/GO_0005923> "GO:0005923")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005923> "bicellular tight junction")
