AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0000082> "G1/S transition of mitotic cell cycle")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0000082> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0044843> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0000278>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0000082> <http://purl.obolibrary.org/obo/GO_0044772>)
