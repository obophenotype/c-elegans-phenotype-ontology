        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001001"/>
        <obo:IAO_0000115>Dauer stage animals exhibit a decrease in self-propelled movement on a solid medium compared to control animals.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>dauer reduced locomotion abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001543</oboInOwl:id>
        <rdfs:label>dauer reduced locomotion variant</rdfs:label>
    </owl:Class>
