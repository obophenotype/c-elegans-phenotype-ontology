        <obo:IAO_0000115>Animals respond to a specific chemical at a lower concentration or a shorter exposure compared to control animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001918</oboInOwl:id>
