        <obo:IAO_0000115>An ammonium ion that is the conjugate acid of serotonin; major species at pH 7.3.</obo:IAO_0000115>
        <chebi:charge>+1</chebi:charge>
        <chebi:formula>C10H13N2O</chebi:formula>
        <chebi:inchi>InChI=1S/C10H12N2O/c11-4-3-7-6-12-10-2-1-8(13)5-9(7)10/h1-2,5-6,12-13H,3-4,11H2/p+1</chebi:inchi>
        <chebi:inchikey>QZAYGJVTTNCVMB-UHFFFAOYSA-O</chebi:inchikey>
        <chebi:mass>177.22250</chebi:mass>
        <chebi:monoisotopicmass>177.10224</chebi:monoisotopicmass>
        <chebi:smiles>[NH3+]CCc1c[nH]c2ccc(O)cc12</chebi:smiles>
        <oboInOwl:hasExactSynonym>2-(5-hydroxy-1H-indol-3-yl)ethanaminium</oboInOwl:hasExactSynonym>
