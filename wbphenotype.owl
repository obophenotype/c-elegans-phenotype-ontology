        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit a decrease in the rate or extent of programmed cell death and thus an increase in cell survival, as it pertains to a sex-specific feature, compared to control populations.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson712</oboInOwl:hasDbXref>
    </owl:Axiom>
    


