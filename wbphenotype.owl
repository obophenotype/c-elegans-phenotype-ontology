    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001570 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001570">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000781"/>
        <obo:IAO_0000115>The characteristic organization of actin filaments into I-bands is disrupted. In C. elegans, actin filaments no longer appear as thin continuous longitudinal stripes along the muscle quadrants.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>body wall muscle actin organization abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
