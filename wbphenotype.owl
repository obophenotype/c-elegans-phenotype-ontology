    <!-- http://purl.obolibrary.org/obo/GO_0005769 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0005769">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0005768"/>
        <obo:IAO_0000115>A membrane-bounded organelle that receives incoming material from primary endocytic vesicles that have been generated by clathrin-dependent and clathrin-independent endocytosis; vesicles fuse with the early endosome to deliver cargo for sorting into recycling or degradation pathways.</obo:IAO_0000115>
