    <!-- http://purl.obolibrary.org/obo/GO_0007398 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007398">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009888"/>
        <obo:IAO_0000115>The process whose specific outcome is the progression of the ectoderm over time, from its formation to the mature structure. In animal embryos, the ectoderm is the outer germ layer of the embryo, formed during gastrulation.</obo:IAO_0000115>
