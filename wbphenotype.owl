        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001506"/>
        <obo:IAO_0000115>Animals exhibit an increase in the rate at which spontaneous backward locomotion is initiated compared to control.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002549</oboInOwl:id>
