        <oboInOwl:hasAlternativeId>GO:0098701</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Wikipedia:Endocytosis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>endocytic import into cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>vesicle endocytosis</oboInOwl:hasExactSynonym>
