        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit enhanced negative effects on growth, health, development or metabolism, in response to dietary sugar-rich diets, compared to controls.</owl:annotatedTarget>
