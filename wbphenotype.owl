    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001571 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001571">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000926"/>
        <obo:IAO_0000115>Variations in the accumulation of muscle proteins at membranes where adjacent muscle cells contact each other and the hypodermis compared to control. In C. elegans, during early embryonic body wall muscle development, muscle, basement membrane, and hypodermal components are all colocalized in a continuous linear structure at the site of muscle-hypodermal contact.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>body wall muscle cell polarization abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001571</oboInOwl:id>
        <rdfs:label>body wall muscle cell polarization variant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Variations in the accumulation of muscle proteins at membranes where adjacent muscle cells contact each other and the hypodermis compared to control. In C. elegans, during early embryonic body wall muscle development, muscle, basement membrane, and hypodermal components are all colocalized in a continuous linear structure at the site of muscle-hypodermal contact.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00001895</oboInOwl:hasDbXref>
    </owl:Axiom>
    


