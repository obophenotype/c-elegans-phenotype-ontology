        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The epidermal cells of the embryo fail to elongate. In C. elegans, this elongation occurs along an anterior-posterior axis, which is required to transform the bean-shaped embryo into the elongated shape of the worm.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
    </owl:Axiom>
    


