    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001420 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001420">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001415"/>
        <obo:IAO_0000115>Animals can move thorough a lawn of bacterially produced biofilm without accumulating an enormous amount of biofilm on its nose. When C. elegans is exposed to certain bacteria (e.g., Y. pestis), a biofilm accumulates on a worm&apos;s head. The presence of this biofilm inhibits feeding by the worm, and thereby prevents growth.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Bah</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001420</oboInOwl:id>
        <rdfs:label>biofilm absent head</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001420"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals can move thorough a lawn of bacterially produced biofilm without accumulating an enormous amount of biofilm on its nose. When C. elegans is exposed to certain bacteria (e.g., Y. pestis), a biofilm accumulates on a worm&apos;s head. The presence of this biofilm inhibits feeding by the worm, and thereby prevents growth.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00005238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:cab</oboInOwl:hasDbXref>
    </owl:Axiom>
    


