        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001569"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The characteristic organization of myosin filaments into discrete A-bands within the muscle cells is disrupted. In C. elegans, myosin filaments no longer appear as continuous longitudinally oriented fibers across the muscle quadrants.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00001894</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
    </owl:Axiom>
