    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0004012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0004012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000284"/>
