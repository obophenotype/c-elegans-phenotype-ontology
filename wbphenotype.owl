    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002012"/>
        <obo:IAO_0000115>Animals differ from controls in respect to the formation of paired chromosome loci.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002113</oboInOwl:id>
