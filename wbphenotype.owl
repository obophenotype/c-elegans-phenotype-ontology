    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001028"/>
        <obo:IAO_0000115>The appearance and association of components along the double lipid bilayer enclosing the nucleus differs from controls. The NE separates nuclear contents from the rest of the cytoplasm and includes the intermembrane space, perinuclear space.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002037</oboInOwl:id>
