    <!-- http://purl.obolibrary.org/obo/GO_0042023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0042023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0044786"/>
        <rdfs:subClassOf>
