        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Dauer stage animals exhibit a decrease in self-propelled movement on a solid medium compared to control animals.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


