    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000703"/>
        <obo:IAO_0000115>The hypodermal cells, which lie along the lateral body wall to form longitudinal stripes of epithelial cells underlying the alae, are misplaced such that they are stacked along the dorsal-ventral axis rather than forming a continuous row of adjacent cells .</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000078</oboInOwl:id>
        <rdfs:label>seam cells stacked</rdfs:label>
    </owl:Class>
