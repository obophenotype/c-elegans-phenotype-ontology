        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001599</oboInOwl:id>
        <rdfs:label>ouabain resistant</rdfs:label>
