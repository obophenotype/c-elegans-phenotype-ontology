    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002061"/>
        <obo:IAO_0000115>The process of decompaction of chromatin that changes chromosome structure from the condensed form to a relaxed disperse form is abolished.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002062</oboInOwl:id>
