        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit an increased girth compared to a control animal of the same developmental stage.</owl:annotatedTarget>
