        <obo:IAO_0000115>The gel-like material, with considerable fine structure, that lies in the matrix space, or lumen, of a mitochondrion. It contains the enzymes of the tricarboxylic acid cycle and, in some organisms, the enzymes concerned with fatty acid oxidation.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>GO:0031980</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>NIF_Subcellular:sao1804523077</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Wikipedia:Mitochondrial_matrix</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>mitochondrial lumen</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>mitochondrial stroma</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>cellular_component</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0005759</oboInOwl:id>
        <rdfs:label>mitochondrial matrix</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0005759"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
