                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0042221"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The directed movement of a motile cell or organism, or the directed growth of a cell guided by a specific chemical concentration gradient. Movement may be towards a higher concentration (positive chemotaxis) or towards a lower concentration (negative chemotaxis).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Chemotaxis</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>taxis in response to chemical stimulus</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0006935</oboInOwl:id>
        <rdfs:label>chemotaxis</rdfs:label>
    </owl:Class>
