        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>VNC nuclear migration variant</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0000512</oboInOwl:id>
        <rdfs:label>VNC nuclear positioning variant</rdfs:label>
    </owl:Class>
