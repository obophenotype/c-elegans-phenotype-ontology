    <!-- http://purl.obolibrary.org/obo/WBbt_0005767 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005767">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005766"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005748"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A group of six equivalent cells forms a tightly constructed &apos;valve&apos; that links the posterior bulb of the pharynx to the anterior four cells of the intestine. These six cells comprise a small epithelial channel with a cuticular lining in continuity with the pharyngeal cuticle and link the lumen of the pharynx to the large lumen of the anterior intestine.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>WBbt:0005435</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>cardia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>esophago-intestinal valve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngeal valve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pharyngo-intestinal valve</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBbt:0005767</oboInOwl:id>
        <rdfs:comment>LINKOUT::WORMATLAS::&lt;http://www.wormatlas.org/ver1/handbook/alimentary/alimentary1.htm#vip&gt;</rdfs:comment>
        <rdfs:label>pharyngeal-intestinal valve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A group of six equivalent cells forms a tightly constructed &apos;valve&apos; that links the posterior bulb of the pharynx to the anterior four cells of the intestine. These six cells comprise a small epithelial channel with a cuticular lining in continuity with the pharyngeal cuticle and link the lumen of the pharynx to the large lumen of the anterior intestine.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


