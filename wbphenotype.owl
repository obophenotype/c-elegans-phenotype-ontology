    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001219 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001219">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001218"/>
        <obo:IAO_0000115>Animals exhibit a decrease in the rate or extent of programmed cell death and thus an increase in cell survival, as it pertains to a sex-specific feature, compared to control populations.</obo:IAO_0000115>
