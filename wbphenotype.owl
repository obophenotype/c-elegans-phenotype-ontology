        <obo:IAO_0000115>Animals exhibit a kinker phenotype that is due to conflicting, simultaneous forward and backward propagating bending waves.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>conflicted kinker</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002548</oboInOwl:id>
