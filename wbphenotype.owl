        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000594"/>
        <obo:IAO_0000115>Variations in the migration pattern of distal tip cells compared to control animals. In C. elegans, DTCs located on the anterior and posterior ends of the gonad primordium typically migrate in a symmetrical U-shaped pattern.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>distal tip cell migration abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>DTC migration abnormal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0000195</oboInOwl:id>
        <rdfs:label>distal tip cell migration variant</rdfs:label>
    </owl:Class>
