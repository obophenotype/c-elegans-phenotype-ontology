    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001542 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001542">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001001"/>
        <obo:IAO_0000115>Any variation in the inhibition of feeding which is induced/occurs during the dauer stage compared to control.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>dauer feeding suppressed abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001542</oboInOwl:id>
        <rdfs:label>dauer feeding suppressed variant</rdfs:label>
    </owl:Class>
