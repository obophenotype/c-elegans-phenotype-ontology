    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001702 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001702">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0004017"/>
        <obo:IAO_0000115>Animals exhibit variations in the directional changes that separate consecutive runs, from that observed for control animals. In C. elegans, these aberrations include variations in the form or extent of omega turns or reversals (shifts from forward to backward movements).</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>directionality abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>reversal abnormal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>turning abnormal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0001702</oboInOwl:id>
        <rdfs:label>directionality variant</rdfs:label>
    </owl:Class>
