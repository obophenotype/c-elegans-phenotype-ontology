    <!-- http://purl.obolibrary.org/obo/CHEBI_35274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33702"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51143"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_parent_hydride"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28938"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A derivative of ammonium, NH4(+), in which one (or more) of the hydrogens bonded to the nitrogen have been replaced with univalent organyl groups. The substituting carbon of the organyl group must not itself be directly attached to a heteroatom (thereby excluding protonated amides, hemiaminals, etc).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>chebi_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>ammonium ion derivatives</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>azanium ion derivative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>azanium ion derivatives</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>CHEBI:35274</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/chebi#3_STAR"/>
        <rdfs:label>ammonium ion derivative</rdfs:label>
    </owl:Class>
