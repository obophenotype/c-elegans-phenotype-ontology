        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002122"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Mitochondria from spermatazoa persist in the developing embryo and animal as a result of bypassing the degradation mechanism that normally destroys paternal mitochondria immediately after fertilization. This can often lead to a form of heteroplasmy.</owl:annotatedTarget>
