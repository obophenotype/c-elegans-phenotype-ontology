                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0048589"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that stops, prevents, or reduces the frequency, rate or extent of developmental growth.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>down regulation of developmental growth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>down-regulation of developmental growth</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>downregulation of developmental growth</oboInOwl:hasExactSynonym>
