        <oboInOwl:hasDbXref>ISBN:0140512888</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBbt_0005785 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005785">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005766"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005175"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The components of the gonad that are separate from the germline proper. In hermaphrodite, these include five tissues which are all derived from the somatic primordium : the distal tip cells, the gonadal sheath, the spermatheca, the spermatheca-uterine valve (sp-ut)  and the uterus.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>somatic germline</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBbt:0005785</oboInOwl:id>
        <rdfs:label>somatic gonad</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005785"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The components of the gonad that are separate from the germline proper. In hermaphrodite, these include five tissues which are all derived from the somatic primordium : the distal tip cells, the gonadal sheath, the spermatheca, the spermatheca-uterine valve (sp-ut)  and the uterus.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:rynl</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


