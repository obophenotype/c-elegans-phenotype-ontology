    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001538 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000028"/>
        <obo:IAO_0000115>Defects in the cellular machinery that targets aberrant mRNAs species (nonsense codons, splice errors, altered untranslated regions etc.) for degradation. In C. elegans, mutations in such loci often act as allele-specific non gene-specific recessive suppressors of certain allele phenotypes and cause abnormal morphogenesis of male and hermaphrodite genitalia.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>Smg</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001538</oboInOwl:id>
        <rdfs:label>mRNA surveillance defective</rdfs:label>
    </owl:Class>
    <owl:Axiom>
