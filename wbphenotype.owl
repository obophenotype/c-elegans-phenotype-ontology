        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A vacuole that is maintained at an acidic pH and which contains degradative enzymes, including a wide variety of acid hydrolases.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GOC:krc</oboInOwl:hasDbXref>
