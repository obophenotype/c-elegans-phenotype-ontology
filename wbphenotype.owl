    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0000396 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0000396">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000399"/>
        <obo:IAO_0000115>Gonadal arms do not bend or curve. In C. elegans gonad arms normally reflex to form a stereotypical U-shaped pattern.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000396</oboInOwl:id>
        <rdfs:label>non reflexed gonad arms</rdfs:label>
    </owl:Class>
