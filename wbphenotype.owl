        <oboInOwl:hasNarrowSynonym>double-stranded RNA biosynthesis</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>double-stranded RNA biosynthetic process</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasNarrowSynonym>dsRNA biosynthesis</oboInOwl:hasNarrowSynonym>
