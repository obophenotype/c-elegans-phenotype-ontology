    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0000333 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0000333">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001006"/>
        <obo:IAO_0000115>The time interval of the stereotyped sequence of muscle contractions by individual pharyngeal muscles that act to draw food into the pharynx is shorter compared to that observed in control (Wormatlas).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000333</oboInOwl:id>
        <rdfs:label>pharyngeal pumps brief</rdfs:label>
