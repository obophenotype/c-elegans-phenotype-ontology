        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000619"/>
        <obo:IAO_0000115>Animals shed fragments of epidermis into the surrounding environment, unlike controls. In embryos, these fragments can be seen in the extra-embryonic space.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002635</oboInOwl:id>
        <rdfs:label xml:lang="en">epidermal shedding</rdfs:label>
    </owl:Class>
