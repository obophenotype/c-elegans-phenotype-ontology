    <!-- http://purl.obolibrary.org/obo/WBbt_0005656 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005332"/>
        <obo:IAO_0000115>Ganglion that lies at the anterior limit of the ventral nerve cord, near the ventral ganglion and nerve ring in the head posterior to the excretory pore. It is open and continuous with the region containing the motoneurons of the ventral cord. In the early L1 this ganglion holds 12 neuron cell bodies plus one neuroblast (Sulston and Horvitz, 1977; White et al., 1986). In the adult animal, the ganglion holds 20 neuron cell bodies.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBbt:0005656</oboInOwl:id>
        <rdfs:label>retrovesicular ganglion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005656"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Ganglion that lies at the anterior limit of the ventral nerve cord, near the ventral ganglion and nerve ring in the head posterior to the excretory pore. It is open and continuous with the region containing the motoneurons of the ventral cord. In the early L1 this ganglion holds 12 neuron cell bodies plus one neuroblast (Sulston and Horvitz, 1977; White et al., 1986). In the adult animal, the ganglion holds 20 neuron cell bodies.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


