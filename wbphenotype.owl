        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000207"/>
        <obo:IAO_0000115>Muscle contractions that make up the defecation motor program are repeated before the onset of the next cycle unlike in control animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000564</oboInOwl:id>
        <rdfs:label>echo defecation cycle</rdfs:label>
    </owl:Class>
