        <oboInOwl:id>WBPhenotype:0001945</oboInOwl:id>
        <rdfs:label>oocytes small</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001945"/>
