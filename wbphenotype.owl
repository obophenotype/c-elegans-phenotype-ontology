        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001841"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any variation in a series of molecular signals that help relay a receptor mediated signal within the cell, compared to control. Second messengers often comprise of ions (eg: Ca2+) or small molecules (cGMP, cAMP etc) that are formed or released into the cytosol.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0019932</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPaper00033456</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
