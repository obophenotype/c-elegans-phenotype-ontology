        <oboInOwl:hasNarrowSynonym>pronuclear nuclear appearance abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001034</oboInOwl:id>
        <rdfs:label>pronuclear nuclear appearance defective early emb</rdfs:label>
    </owl:Class>
