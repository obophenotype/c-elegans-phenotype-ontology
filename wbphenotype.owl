    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001250"/>
        <obo:IAO_0000115>The microtuble-based fibrillar-bundles of the amphid sensory cilia are reduced in length compared to those in control animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001251</oboInOwl:id>
        <rdfs:label>amphid channel axoneme short</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The microtuble-based fibrillar-bundles of the amphid sensory cilia are reduced in length compared to those in control animals.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00000932</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPaper00027116</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson712</oboInOwl:hasDbXref>
