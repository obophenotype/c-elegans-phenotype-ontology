    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001237"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any perturbation that causes an increase in the frequency of axon outgrowth compared to control. As a result, an excess number of axonal projections are generated.</owl:annotatedTarget>
