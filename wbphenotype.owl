    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001728"/>
        <obo:IAO_0000115>Males receive copulatory plugs from other males, deposited elsewhere on their bodies, in the absence of any orifice. This typically involves penetration of the depositing male&apos;s spicules directly through the cuticle of the recipient male.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Plob</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002274</oboInOwl:id>
        <rdfs:label>plugged on body</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002274"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Males receive copulatory plugs from other males, deposited elsewhere on their bodies, in the absence of any orifice. This typically involves penetration of the depositing male&apos;s spicules directly through the cuticle of the recipient male.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson22615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson7165</oboInOwl:hasDbXref>
    </owl:Axiom>
    


