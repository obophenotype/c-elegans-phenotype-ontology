    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002145 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000743"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001776"/>
        <obo:IAO_0000115>Animals are unable to produce or maintain short interfering RNA (siRNA) from double stranded RNA (dsRNA). siRNAs are required to initiate interference of gene expression.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002145</oboInOwl:id>
        <rdfs:label>siRNA processing defective</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002145"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals are unable to produce or maintain short interfering RNA (siRNA) from double stranded RNA (dsRNA). siRNAs are required to initiate interference of gene expression.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00027057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson712</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002146 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000113"/>
        <obo:IAO_0000115>Animals exhibit variations from controls in the expression, biogenesis, processing, or stability of any class of small RNA species in the germline. Small RNAs include microRNAs (miRNAs), tiny noncoding RNAs (tncRNAs), cluster of small X-chromosome derived RNAs (X cluster), and endogenous short interfering RNA (endo-siRNAs).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002146</oboInOwl:id>
        <rdfs:label>small RNA germline expression variant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002146"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit variations from controls in the expression, biogenesis, processing, or stability of any class of small RNA species in the germline. Small RNAs include microRNAs (miRNAs), tiny noncoding RNAs (tncRNAs), cluster of small X-chromosome derived RNAs (X cluster), and endogenous short interfering RNA (endo-siRNAs).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00027057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson712</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000113"/>
        <obo:IAO_0000115>Animals exhibit variations from controls in the expression, biogenesis, processing, or stability of any class of small RNA species in somatic cells. Small RNAs include microRNAs (miRNAs), tiny noncoding RNAs (tncRNAs), cluster of small X-chromosome derived RNAs (X cluster), and endogenous short interfering RNA (endo-siRNAs).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002147</oboInOwl:id>
        <rdfs:label>small RNA somatic expression variant</rdfs:label>
    </owl:Class>
