        <obo:IAO_0000115>Any perturbation that renders epithelial cells incompetent at undergoing membrane fusion during development.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>PMID:15341747</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000702</oboInOwl:id>
        <rdfs:label>epithelial cell fusion failure</rdfs:label>
    </owl:Class>
    <owl:Axiom>
