            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multiple sarcomere muscle cell in which the thin and thick filaments adopt highly ordered patterns, with the thin filaments anchored at dense bodies.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>striated muscle cell</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
