        <obo:IAO_0000115>Animals exhibit a greater abundance of bacteria of the Enterobacteriaceae family in the gut, compared to controls.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002547</oboInOwl:id>
