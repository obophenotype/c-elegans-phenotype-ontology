        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001980"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit variations in the increase in size of compartments of the germline. In the C. elegans germline, syncytial compartments enlarge just prior to and coincident with the loop region, eventually abscising, to become fully enclosed germ cells (oocytes).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00038381</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


