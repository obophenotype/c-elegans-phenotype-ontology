        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0004017"/>
        <obo:IAO_0000115>Animals exhibit uncharacteristic muscle contractions during the process by which they travel from one location to another.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>convulsive</oboInOwl:hasRelatedSynonym>
