    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002550 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002550">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002548"/>
        <obo:IAO_0000115>Animals exhibit a kinker phenotype that is due to conflicting, simultaneous forward and backward propagating bending waves, and over time has a tendency to move slowly backward due to a dominating reversal neural circuit.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002550</oboInOwl:id>
        <rdfs:label xml:lang="en">conflicted kinker with gradual backward movement</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002550"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit a kinker phenotype that is due to conflicting, simultaneous forward and backward propagating bending waves, and over time has a tendency to move slowly backward due to a dominating reversal neural circuit.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00040432</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2987</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson720</oboInOwl:hasDbXref>
    </owl:Axiom>
    


