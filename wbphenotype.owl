    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001047"/>
        <obo:IAO_0000115>Animals exhibit variations in the characteristic movement towards typically attractive alkaline pH (pH higher than 7) compared to control. However animals tend to avoid very high pH levels (pH11).  pH is a measure of the acidity or basicity of an aqueous solution. In C. elegans animals chemotax toward higher alkaline pH.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>alkaline pH sensing variant</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>alkalinity sensing variant</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0002171</oboInOwl:id>
        <rdfs:label>alkaline pH chemotaxis variant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit variations in the characteristic movement towards typically attractive alkaline pH (pH higher than 7) compared to control. However animals tend to avoid very high pH levels (pH11).  pH is a measure of the acidity or basicity of an aqueous solution. In C. elegans animals chemotax toward higher alkaline pH.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0036176</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPaper00042397</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
