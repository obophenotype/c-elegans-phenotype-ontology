    <!-- http://purl.obolibrary.org/obo/WBbt_0005298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005135"/>
        <obo:IAO_0000115>ganglion lies beside the nerve ring in the head, just anterior of the retrovesicular ganglion. It contains about 20 interneuron and motorneuron cell bodies that all send their neuronal processes into the ring. The cell bodies are divided into two groups by the intrusion of the excretory duct and canal. The cells are bounded by a basal lamina which physically separates them from the lateral ganglion even though they are adjacent to one another.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>WB:rynl</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>ventral ganglia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBbt:0005298</oboInOwl:id>
        <rdfs:label>ventral ganglion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005298"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>ganglion lies beside the nerve ring in the head, just anterior of the retrovesicular ganglion. It contains about 20 interneuron and motorneuron cell bodies that all send their neuronal processes into the ring. The cell bodies are divided into two groups by the intrusion of the excretory duct and canal. The cells are bounded by a basal lamina which physically separates them from the lateral ganglion even though they are adjacent to one another.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WBPaper:00038216</oboInOwl:hasDbXref>
    </owl:Axiom>
    


