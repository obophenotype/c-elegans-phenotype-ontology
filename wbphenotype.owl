        <obo:IAO_0000115>The life span of dauer-staged animals is either longer or shorter than that observed in control dauer animals.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>dauer lifespan abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001540</oboInOwl:id>
        <rdfs:label>dauer lifespan variant</rdfs:label>
    </owl:Class>
