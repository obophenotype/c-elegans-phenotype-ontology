        <oboInOwl:hasRelatedSynonym>transitional epithelium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBbt:0005754</oboInOwl:id>
        <rdfs:comment>LINKOUT::WORMATLAS::&lt;http://www.wormatlas.org/ver1/handbook/hypodermis/hypsupportother.htm&gt;</rdfs:comment>
        <rdfs:label>interfacial epithelial cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
