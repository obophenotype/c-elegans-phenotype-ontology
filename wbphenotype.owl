        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals fail to respond to the aggregation of proteins that elicits a paralysis response in control animals.</owl:annotatedTarget>
