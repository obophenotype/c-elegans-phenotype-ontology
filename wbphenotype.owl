        <obo:IAO_0000115>Any variation in the process by which a cell nucleus is divided into two nuclei, with DNA and other nuclear contents distributed between the daughter nuclei, compared to control.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>nuclear division abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>karyokinesis abnormal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0000504</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/wbphenotype#phenotype_slim_wb"/>
        <rdfs:comment>Possible XP.</rdfs:comment>
        <rdfs:label>nuclear division variant</rdfs:label>
    </owl:Class>
