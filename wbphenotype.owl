                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0051325"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The cell cycle &apos;gap&apos; phase which is the interval between the completion of DNA segregation (usually by mitosis or meiosis) and the beginning of DNA synthesis.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:G1_phase</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
