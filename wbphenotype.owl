        <obo:IAO_0000115>A pyridoisoquinoline comprising emetam having methoxy substituents at the 6&apos;-, 7&apos;-, 10- and 11-positions. It is an antiprotozoal agent and emetic. It inhibits SARS-CoV2, Zika and Ebola virus replication and displays antimalarial, antineoplastic and antiamoebic properties.</obo:IAO_0000115>
        <chebi:charge>0</chebi:charge>
        <chebi:formula>C29H40N2O4</chebi:formula>
        <chebi:inchi>InChI=1S/C29H40N2O4/c1-6-18-17-31-10-8-20-14-27(33-3)29(35-5)16-23(20)25(31)12-21(18)11-24-22-15-28(34-4)26(32-2)13-19(22)7-9-30-24/h13-16,18,21,24-25,30H,6-12,17H2,1-5H3/t18-,21-,24+,25-/m0/s1</chebi:inchi>
        <chebi:inchikey>AUVVAXYIELKVAI-CKBKHPSWSA-N</chebi:inchikey>
