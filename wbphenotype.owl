        <obo:IAO_0000115>Cells exhibit variations in the process whereby a cell progresses from metaphase to anaphase, compared to control. Metaphase is the second stage of chromosome segregation in the cell cycle where chromosomes become aligned on the equatorial plate of the cell and anaphase is the stage where sister chromatids (or homologous chromosomes) separate and migrate towards the poles of the spindle.</obo:IAO_0000115>
        <oboInOwl:hasAlternativeId>WBPhenotype:0001214</oboInOwl:hasAlternativeId>
        <oboInOwl:hasExactSynonym>metaphase to anaphase transition fails</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Mat</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0001496</oboInOwl:id>
        <rdfs:label>metaphase to anaphase transition defect</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cells exhibit variations in the process whereby a cell progresses from metaphase to anaphase, compared to control. Metaphase is the second stage of chromosome segregation in the cell cycle where chromosomes become aligned on the equatorial plate of the cell and anaphase is the stage where sister chromatids (or homologous chromosomes) separate and migrate towards the poles of the spindle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0007091</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson712</oboInOwl:hasDbXref>
    </owl:Axiom>
    


