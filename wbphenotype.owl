    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002365 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002365">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001911"/>
        <obo:IAO_0000115>Following axon damage, animals do not undergo axonal fusion after reconnection between the regrowing axon and its separated segment to the same extent as observed in control animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002365</oboInOwl:id>
        <rdfs:label>regenerative axonal fusion defective</rdfs:label>
    </owl:Class>
