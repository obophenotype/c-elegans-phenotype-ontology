        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit variations in the form, structure or composition of any portion of the most posterior region of the body compared to control. The anterior bound of the tail is not well defined though it might range from the position of the post-deirids to the opening of the anus (Wormatlas).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


