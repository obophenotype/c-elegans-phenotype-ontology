        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The whole body undergoes longitudinal shortening in response to head touch or tail touch (Wormatlas).</owl:annotatedTarget>
