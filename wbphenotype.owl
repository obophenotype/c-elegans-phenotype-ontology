    <!-- http://purl.obolibrary.org/obo/GO_0006914 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0006914">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009056"/>
