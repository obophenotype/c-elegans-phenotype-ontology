        <oboInOwl:hasDbXref>WB:WBPerson2987</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002370 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002370">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001273"/>
        <obo:IAO_0000115>Animals fail to execute their characteristic movements to avoid noxious heat in a manner consistent with controls.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002370</oboInOwl:id>
