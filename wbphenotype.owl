        <rdfs:label>reduced levels of reduced glutathione</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001900"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit a decrease in the cellular levels of reduced glutathione (GSH), compared to control. Reduced levels of GSH may be an indication of susceptibility to oxidative stress.</owl:annotatedTarget>
