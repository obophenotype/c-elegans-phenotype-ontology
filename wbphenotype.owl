        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Pharyngeal pumping is not influenced by treatment with specific compounds (eg: serotonin) in the same manner as control animals.</owl:annotatedTarget>
