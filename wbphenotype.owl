    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002122 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002122">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002121"/>
        <obo:IAO_0000115>Mitochondria from spermatazoa persist in the developing embryo and animal as a result of bypassing the degradation mechanism that normally destroys paternal mitochondria immediately after fertilization. This can often lead to a form of heteroplasmy.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002122</oboInOwl:id>
        <rdfs:label>persistence of paternal mitochondria</rdfs:label>
    </owl:Class>
