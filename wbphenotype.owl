        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001831"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any variation in the formation of intestinal microvilli. Microvilli are actin-based cellular structures that form plasma membrane projections into the extracellular space and whose specialized shape provides increased cellular surface area. Microvilli are a crucial component of the terminal differentiation process for many epithelial cell types, usually ones that play an absorptive or filtering role.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00025171</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


