        <oboInOwl:id>GO:0007369</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
        <rdfs:label>gastrulation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
