    <!-- http://purl.obolibrary.org/obo/GO_0007020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0000226"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0046785"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which tubulin alpha-beta heterodimers begin aggregation to form an oligomeric tubulin structure (a microtubule seed). Microtubule nucleation is the initiating step in the formation of a microtubule in the absence of any existing microtubules (&apos;de novo&apos; microtubule formation).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>Wikipedia:Microtubule_nucleation</oboInOwl:hasDbXref>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
