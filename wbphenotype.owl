                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0006270"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Regulated re-replication of DNA within a single cell cycle, resulting in an increased cell ploidy. An example of this process occurs in the synthesis of Drosophila salivary gland cell polytene chromosomes.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>DNA endoreplication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>DNA re-duplication</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0042023</oboInOwl:id>
        <rdfs:comment>Note that this term is only to be used in situations were this process occurs normally. Not to be used to describe mutant or diseased states.</rdfs:comment>
        <rdfs:label>DNA endoreduplication</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0042023"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
