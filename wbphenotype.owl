    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002677 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002677">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000688"/>
        <obo:IAO_0000115>Animals exhibit sterility that manifests specifically during the adult life stage</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002677</oboInOwl:id>
        <rdfs:comment>Comment from Caroline Goutte about allele ar179 in the context of WBPaper00053552 (PMID:29242286): GSCs [germline stem cells] are initially present, but then lost during adulthood; hermaphrodite is fertile but has low brood size and reduced reproductive span</rdfs:comment>
        <rdfs:label xml:lang="en">adult-onset sterility</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002677"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit sterility that manifests specifically during the adult life stage</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00053552</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2987</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002677"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#comment"/>
