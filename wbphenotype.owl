    <!-- http://purl.obolibrary.org/obo/GO_0007409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0048812"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0048667"/>
            </owl:Restriction>
        </rdfs:subClassOf>
