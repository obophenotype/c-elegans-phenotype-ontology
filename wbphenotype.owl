        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000544</oboInOwl:id>
        <rdfs:label>backward kinker</rdfs:label>
