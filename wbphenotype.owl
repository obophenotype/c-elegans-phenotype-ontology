        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any variation in the form or composition of the structure that lies on the ventral surface just anterior and central to the base of the spicule openings (small lump on the gubernaculum of the male tail) and contains a sensory structure called the hook sensillum, compared to control. In C. elegans the hook is necessary for proper male mating.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


