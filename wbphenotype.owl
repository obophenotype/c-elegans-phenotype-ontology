    <!-- http://purl.obolibrary.org/obo/WBbt_0005774 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBbt_0005774">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005757"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005748"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>a feature of the male tail, caudal to the proctodeum, where the vas deferens and the intestine open out jointly near the tail tip to discharge their contents.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>worm_anatomy</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBbt:0005774</oboInOwl:id>
        <rdfs:label>cloaca</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBbt_0005774"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
