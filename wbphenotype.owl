        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001889"/>
        <obo:IAO_0000115>Any variation in the extremely thin elongated cytoplasmic filament, usually composed principally of actin protein to form a myofilament lattice, as in muscle cells compared to control (Wormatlas).</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>thin filament abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>thin filament variant</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0000781</oboInOwl:id>
        <rdfs:label>body wall muscle thin filament variant</rdfs:label>
    </owl:Class>
