        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001048"/>
        <obo:IAO_0000115>Animals exhibit variations in the characteristic desensitization to a volatile organic chemo-attractive signal in a time-concentration dependent and reversible manner compared to control animals.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>odorant adaptation abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000203</oboInOwl:id>
        <rdfs:label>odorant adaptation variant</rdfs:label>
    </owl:Class>
