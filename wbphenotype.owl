        <oboInOwl:hasExactSynonym>Ubiquinone complex variant</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002144</oboInOwl:id>
        <rdfs:label>mitochondrial respiratory complex I variant</rdfs:label>
    </owl:Class>
