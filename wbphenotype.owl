    <!-- http://purl.obolibrary.org/obo/GO_0051318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0051318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0022403"/>
        <rdfs:subClassOf>
            <owl:Restriction>
