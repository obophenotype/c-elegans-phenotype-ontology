        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000145"/>
        <obo:IAO_0000115>Animals exhibit a decline in fertility over generations. This is often assessed by counting laid eggs over successive generations.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>generational loss of fertility</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>progressive loss of fertility</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>transgenerational epigenetic loss of fertility</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0002168</oboInOwl:id>
        <rdfs:label>transgenerational loss of fertility</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002168"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit a decline in fertility over generations. This is often assessed by counting laid eggs over successive generations.</owl:annotatedTarget>
