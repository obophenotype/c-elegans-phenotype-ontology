        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001969"/>
        <obo:IAO_0000115>Animals exhibit variations in the increase in size of compartments of the germline. In the C. elegans germline, syncytial compartments enlarge just prior to and coincident with the loop region, eventually abscising, to become fully enclosed germ cells (oocytes).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001980</oboInOwl:id>
        <rdfs:label>germ cell compartment expansion variant</rdfs:label>
    </owl:Class>
