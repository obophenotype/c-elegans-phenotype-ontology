        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001961"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals continue to produce progeny significantly past the time reproduction stops in control animals.</owl:annotatedTarget>
