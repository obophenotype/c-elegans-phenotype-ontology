        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The period during which a worm usually does not lay eggs is short compared with control animals, based on the analysis of the distribution of the log intervals of egg-laying events.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:cab</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>pmid:9697864</oboInOwl:hasDbXref>
