        <obo:IAO_0000115>Animals are missing the anchor cell. In C. elegans the anchor cell is a key organizer of vulval patterning and morphogenesis.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002136</oboInOwl:id>
        <rdfs:label>no anchor cell</rdfs:label>
    </owl:Class>
