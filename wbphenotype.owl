        <owl:annotatedTarget>OBSOLETE. Any variation in the prevention of mRNA translation that normally occurs in certain cells, compared to control.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001910 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001910">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001348"/>
        <obo:IAO_0000115>Animals exhibit variations in the assembly, arrangement, orientation, or disassembly of the kinetochore, a multisubunit protein complex on chromosomes where the spindle fibers attach during cell division to pull the chromosomes apart.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001910</oboInOwl:id>
        <rdfs:comment>Possible XP.</rdfs:comment>
        <rdfs:label>kinetochore organization variant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001910"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals exhibit variations in the assembly, arrangement, orientation, or disassembly of the kinetochore, a multisubunit protein complex on chromosomes where the spindle fibers attach during cell division to pull the chromosomes apart.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>GO:0051383</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPaper00035270</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001911 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001911">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000880"/>
        <obo:IAO_0000115>Animals do not regrow axons following axon loss or damage, to the same extent, or in the same manner as observed in control animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001911</oboInOwl:id>
        <rdfs:label>axon regeneration defective</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001911"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals do not regrow axons following axon loss or damage, to the same extent, or in the same manner as observed in control animals.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson712</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001912 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001912">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000618"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002174"/>
        <obo:IAO_0000115>The number of coelomocytes are reduced compared to control animals. Coelomocytes are free-floating spherical cells lying in the pseudocoelomic cavity of animals that can endocytose many compounds.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001912</oboInOwl:id>
        <rdfs:label>fewer coelomocytes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001912"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The number of coelomocytes are reduced compared to control animals. Coelomocytes are free-floating spherical cells lying in the pseudocoelomic cavity of animals that can endocytose many compounds.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00035290</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2987</oboInOwl:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001913 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001913">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000618"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002175"/>
        <obo:IAO_0000115>The number of coelomocytes are increased compared to control animals. Coelomocytes are free-floating spherical cells lying in the pseudocoelomic cavity of animals that can endocytose many compounds.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0001913</oboInOwl:id>
        <rdfs:label>excess coelomocytes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001913"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The number of coelomocytes are increased compared to control animals. Coelomocytes are free-floating spherical cells lying in the pseudocoelomic cavity of animals that can endocytose many compounds.</owl:annotatedTarget>
