        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001061"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>In C. elegans, this is characterized by the failure to move towards typically attractive volatile organic molecules sensed by the AWA compared to control.</owl:annotatedTarget>
