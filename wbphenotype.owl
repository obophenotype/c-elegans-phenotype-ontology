        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000421"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals fail to respond to the concentration of levamisole that elicits a response in control animals. Alternatively, animals require increased concentration or longer exposure to this compound to elicit the response compared to control animals. In C. elegans resistance to levamisole is often assayed via body contraction response, ventral tail curling response etc.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00000484</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
    </owl:Axiom>
    


