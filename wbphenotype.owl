    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001067"/>
        <obo:IAO_0000115>More eggs are laid during the active phase compared with control animals, based on the analysis of the distribution of the log intervals of egg-laying events.</obo:IAO_0000115>
