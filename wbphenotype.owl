    <!-- http://purl.obolibrary.org/obo/GO_0055085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0055085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006810"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0009987"/>
        <obo:IAO_0000115>The process in which a solute is transported across a lipid bilayer, from one side of a membrane to the other.</obo:IAO_0000115>
        <oboInOwl:created_by>tb</oboInOwl:created_by>
        <oboInOwl:creation_date>2015-10-21T13:22:47Z</oboInOwl:creation_date>
        <oboInOwl:hasAlternativeId>GO:0090662</oboInOwl:hasAlternativeId>
        <oboInOwl:hasDbXref>Reactome:R-HSA-382556</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-425407</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>Reactome:R-HSA-5223345</oboInOwl:hasDbXref>
        <oboInOwl:hasExactSynonym>membrane transport</oboInOwl:hasExactSynonym>
        <oboInOwl:hasNarrowSynonym>ATP hydrolysis coupled transmembrane transport</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0055085</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_chembl"/>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#goslim_drosophila"/>
