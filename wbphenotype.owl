        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A simple form of learning whereby the repeated presence of a stimulus leads to a change in the probability or strength of the response to that stimulus. There is no association of one type of stimulus with another, rather it is a generalized response to the environment.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>ISBN:0582227089</oboInOwl:hasDbXref>
    </owl:Axiom>
    


