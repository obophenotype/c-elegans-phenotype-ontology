        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001701"/>
        <obo:IAO_0000115>The whole body undergoes longitudinal shortening in response to head touch or tail touch (Wormatlas).</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000563</oboInOwl:id>
