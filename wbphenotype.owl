    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0000668 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0000668">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001260"/>
        <obo:IAO_0000115>Any variation that results in the presence of mature oocytes with distended polyploid nuclei. In C. elegans, such oocytes mature and exit diakinesis, but are often not properly ovulated or fertilized.</obo:IAO_0000115>
        <oboInOwl:hasBroadSynonym>Emo</oboInOwl:hasBroadSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>arrest in meiosis I</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0000668</oboInOwl:id>
        <rdfs:label>endomitotic oocytes</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000668"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any variation that results in the presence of mature oocytes with distended polyploid nuclei. In C. elegans, such oocytes mature and exit diakinesis, but are often not properly ovulated or fertilized.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:kmva</oboInOwl:hasDbXref>
    </owl:Axiom>
    


