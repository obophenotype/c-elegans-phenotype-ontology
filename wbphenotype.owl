    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001569 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000782"/>
        <obo:IAO_0000115>The characteristic organization of myosin filaments into discrete A-bands within the muscle cells is disrupted. In C. elegans, myosin filaments no longer appear as continuous longitudinally oriented fibers across the muscle quadrants.</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>body wall muscle myosin organization abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>Dim</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>body wall muscle thick myofilament organization abnormal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0001569</oboInOwl:id>
        <rdfs:label>body wall muscle myosin organization defective</rdfs:label>
    </owl:Class>
