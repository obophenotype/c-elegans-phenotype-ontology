    <!-- http://purl.obolibrary.org/obo/GO_0043277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0043277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0006909"/>
        <obo:IAO_0000115>The recognition and removal of an apoptotic cell by a neighboring cell or by a phagocyte.</obo:IAO_0000115>
        <oboInOwl:hasExactSynonym>apoptotic cell removal</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>efferocytosis</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>programmed cell clearance</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0043277</oboInOwl:id>
        <rdfs:comment>Note that unlike mammals or Drosophila, C. elegans (and many lower organisms) do not have professional macrophages/phagocytes, instead cell corpses are engulfed by neighboring cells. Cell types that can function as engulfing cells include hypodermal cells, gonadal sheath cells, pharyngeal muscle cells, and intestinal cells.</rdfs:comment>
        <rdfs:label>apoptotic cell clearance</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0043277"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
