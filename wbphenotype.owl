        <owl:annotatedTarget>Any variation in the progression of the fluid-filled compartment inside the developing embryo at the onset of gastrulation over time from its formation to its mature structure compared to control (Wormatlas).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


