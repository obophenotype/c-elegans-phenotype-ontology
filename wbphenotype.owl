        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals become paralyzed in response to aggregation of proteins like poly-glutamine or beta-amyloid.</owl:annotatedTarget>
