        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The hypodermal cells, which lie along the lateral body wall to form longitudinal stripes of epithelial cells underlying the alae, are misplaced such that they are stacked along the dorsal-ventral axis rather than forming a continuous row of adjacent cells .</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00003081</oboInOwl:hasDbXref>
    </owl:Axiom>
    


