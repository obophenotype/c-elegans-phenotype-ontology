        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000456"/>
        <obo:IAO_0000115>Animals do not respond to stroking to the head or tail with a hair or similar fiber, but does respond to stronger mechanical stimuli such as prodding with a fine platinum wire or similar tool compared to controls.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>light body touch insensitive</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>WBPhenotype:0000398</oboInOwl:id>
        <rdfs:label>light body touch resistant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000398"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
