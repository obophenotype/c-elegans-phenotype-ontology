    <!-- http://purl.obolibrary.org/obo/GO_0071479 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0071479">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0010212"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0071478"/>
        <obo:IAO_0000115>Any process that results in a change in state or activity of a cell (in terms of movement, secretion, enzyme production, gene expression, etc.) as a result of a ionizing radiation stimulus. Ionizing radiation is radiation with sufficient energy to remove electrons from atoms and may arise from spontaneous decay of unstable isotopes, resulting in alpha and beta particles and gamma rays. Ionizing radiation also includes X-rays.</obo:IAO_0000115>
        <oboInOwl:created_by>mah</oboInOwl:created_by>
        <oboInOwl:creation_date>2009-12-18T02:00:31Z</oboInOwl:creation_date>
