        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Cells display reduced incorporation of the thymidine analogue 5-Ethynyl-2&apos;-deoxyuridine (EdU), suggesting reduced cell proliferation. Incorporation of EdU is an indication of active DNA synthesis and thus an indication of cells proceeding through the cell cycle.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:32973031</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson2987</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson36183</oboInOwl:hasDbXref>
    </owl:Axiom>
    


