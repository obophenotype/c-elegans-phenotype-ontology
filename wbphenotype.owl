        <obo:IAO_0000115>Any variation in the multiple rounds of DNA replication that take place without chromosome condensation, segregation or cytokinesis compared to control. In C. elegans this process is normally seen in intestinal nuclei during each larval lethargus which results in adult intestinal nuclei with 32 copies (32C) of each chromosome(Wormatlas).</obo:IAO_0000115>
        <oboInOwl:hasNarrowSynonym>endoreduplication abnormal</oboInOwl:hasNarrowSynonym>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000503</oboInOwl:id>
        <rdfs:label>endoreduplication variant</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000503"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any variation in the multiple rounds of DNA replication that take place without chromosome condensation, segregation or cytokinesis compared to control. In C. elegans this process is normally seen in intestinal nuclei during each larval lethargus which results in adult intestinal nuclei with 32 copies (32C) of each chromosome(Wormatlas).</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPerson2021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
    </owl:Axiom>
    


