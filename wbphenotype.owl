        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A non-sex chromosome fails to segregate away from its homologous chromosome, resulting in gametes with no or extra copies of the non-sex homolog.</owl:annotatedTarget>
