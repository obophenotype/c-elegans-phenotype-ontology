        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals lack a properly developed posterior region compared to control. In C. elegans, mutants exhibit a severely deformed posterior region with a variable knob-like shape; accompanied by arrest at about the time of hatching with fairly normal pharyngeal and anterior development. Most mutants arrest as L1 larvae, and 5% do not hatch.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:cab</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:cgc4499</oboInOwl:hasDbXref>
    </owl:Axiom>
    


