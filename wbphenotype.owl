        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Animals fail to execute their characteristic movements to avoid noxious heat in a manner consistent with controls.</owl:annotatedTarget>
