    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001937 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001937">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001935"/>
        <obo:IAO_0000115>Animals respond to protein aggregation at a lower concentration of aggregates or in less time compared to control animals.</obo:IAO_0000115>
