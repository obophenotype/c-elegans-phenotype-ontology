    <!-- http://purl.obolibrary.org/obo/GO_0007028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0016043"/>
        <obo:IAO_0000115>A process that is carried out at the cellular level which results in the assembly, arrangement of constituent parts, or disassembly of the cytoplasm. The cytoplasm is all of the contents of a cell excluding the plasma membrane and nucleus, but including other subcellular structures.</obo:IAO_0000115>
