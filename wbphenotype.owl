        <oboInOwl:hasExactSynonym>ATPase activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ATPase activity, coupled</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>ATPase-dependent activity</oboInOwl:hasExactSynonym>
        <oboInOwl:hasOBONamespace>molecular_function</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0140657</oboInOwl:id>
        <oboInOwl:inSubset rdf:resource="http://purl.obolibrary.org/obo/go#gocheck_do_not_annotate"/>
