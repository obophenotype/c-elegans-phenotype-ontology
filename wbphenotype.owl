    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0001061 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0001061">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001438"/>
        <obo:IAO_0000115>In C. elegans, this is characterized by the failure to move towards typically attractive volatile organic molecules sensed by the AWA compared to control.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
