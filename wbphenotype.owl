    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002112 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002112">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002012"/>
        <obo:IAO_0000115>Animals are unable to maintain paired chromosome throughout pachytene.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
