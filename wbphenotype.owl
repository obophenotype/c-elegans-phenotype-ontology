    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002140 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000738"/>
        <obo:IAO_0000115>Males do not respond to small molecules or compounds that have been shown to attract control males. This phenotype is often measured by an increase in reversal frequency or time spent in a specified scoring region</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0002140</oboInOwl:id>
        <rdfs:label>male attraction response variant</rdfs:label>
    </owl:Class>
