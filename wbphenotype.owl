                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0002181"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The successive addition of amino acid residues to a nascent polypeptide chain during protein biosynthesis in the cytoplasm.</obo:IAO_0000115>
        <oboInOwl:created_by>hjd</oboInOwl:created_by>
        <oboInOwl:creation_date>2011-06-09T03:14:42Z</oboInOwl:creation_date>
        <oboInOwl:hasOBONamespace>biological_process</oboInOwl:hasOBONamespace>
        <oboInOwl:id>GO:0002182</oboInOwl:id>
        <rdfs:label>cytoplasmic translational elongation</rdfs:label>
