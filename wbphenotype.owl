    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0002367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0002367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000738"/>
        <obo:IAO_0000115>Animals are less successful than controls in extracting themselves from mesh or other non-living obstructing obstacles.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
