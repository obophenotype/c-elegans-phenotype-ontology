        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0002413"/>
        <obo:IAO_0000115>Haploid female germ cells (oocytes) contain more than one nucleus.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:hasRelatedSynonym>multinucleate oocyte</oboInOwl:hasRelatedSynonym>
