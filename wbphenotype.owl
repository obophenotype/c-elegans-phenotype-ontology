    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0004017"/>
        <obo:IAO_0000115>The animal moves or rests with uncharacteristic loss of smooth sinusoidal motion or body posture. Movement is often characterized by severe bending motions, more sharply angled and/or much deeper than stereotypical sinusoidal body bends of the control animals.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000002</oboInOwl:id>
        <rdfs:label>kinker</rdfs:label>
    </owl:Class>
