    <!-- http://purl.obolibrary.org/obo/WBPhenotype_0000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/WBPhenotype_0000242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0001478"/>
        <obo:IAO_0000115>The epidermal cells of the embryo fail to elongate. In C. elegans, this elongation occurs along an anterior-posterior axis, which is required to transform the bean-shaped embryo into the elongated shape of the worm.</obo:IAO_0000115>
        <oboInOwl:hasOBONamespace>C_elegans_phenotype_ontology</oboInOwl:hasOBONamespace>
        <oboInOwl:id>WBPhenotype:0000242</oboInOwl:id>
        <rdfs:label>body elongation defective</rdfs:label>
    </owl:Class>
