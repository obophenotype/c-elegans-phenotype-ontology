        <owl:annotatedTarget>The size of haploid female germ cells (oocytes) are significantly smaller compared to control.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>WB:WBPaper00038381</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>WB:WBPerson557</oboInOwl:hasDbXref>
