        <oboInOwl:hasRelatedSynonym>chromosomal pairing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>GO:0007129</oboInOwl:id>
        <rdfs:label>homologous chromosome pairing at meiosis</rdfs:label>
    </owl:Class>
