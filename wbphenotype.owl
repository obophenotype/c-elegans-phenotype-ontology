        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/WBPhenotype_0000002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The animal moves or rests with uncharacteristic loss of smooth sinusoidal motion or body posture. Movement is often characterized by severe bending motions, more sharply angled and/or much deeper than stereotypical sinusoidal body bends of the control animals.</owl:annotatedTarget>
